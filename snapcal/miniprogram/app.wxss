/* 全局样式 */
page {
  /* 现代圆润派配色 */
  --primary-color: #10B981; /* 薄荷绿 Mint 500 */
  --primary-dark: #059669;  /* 深薄荷绿 Mint 600 */
  --primary-light: #ECFDF5; /* 极浅薄荷绿 Mint 50 */
  
  --accent-color: #F97316;  /* 活力橙 Orange 500 */
  --accent-light: #FFF7ED;  /* 浅橙色 Orange 50 */
  
  --bg-color: #F9FAFB;      /* 保持清爽灰白 */
  --text-color: #1F2937;    /* 深灰偏黑 Gray 800 */
  --text-secondary: #6B7280;/* 次级灰 Gray 500 */
  
  --border-color: #E5E7EB;
  --error-color: #EF4444;
  --warning-color: #F59E0B;
  --success-color: #10B981;
  
  /* 现代圆润字体栈 */
  --font-number: "Nunito", "DIN Alternate", "PingFang SC", "Helvetica Neue", "Arial", sans-serif;
  
  /* 字体大小 */
  --font-size-xs: 24rpx;
  --font-size-sm: 28rpx;
  --font-size-base: 32rpx;
  --font-size-lg: 36rpx;
  --font-size-xl: 40rpx;
  
  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  
  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  
  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

/* 重置默认样式 */
page {
  background-color: var(--bg-color);
  color: var(--text-color);
  font-size: var(--font-size-base);
  line-height: 1.6;
}

view, text, image, navigator, input, scroll-view, swiper, button {
  box-sizing: border-box;
}

/* WebView 滚动条兼容（隐藏） */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background: transparent;
}

/* 通用工具类 */
.container {
  padding: var(--spacing-lg);
}

.card {
  background: #ffffff;
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

.text-center {
  text-align: center;
}

.text-primary {
  color: var(--primary-color);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-error {
  color: var(--error-color);
}

.mb-sm {
  margin-bottom: var(--spacing-sm);
}

.mb-md {
  margin-bottom: var(--spacing-md);
}

.mb-lg {
  margin-bottom: var(--spacing-lg);
}

/* ========== 底部固定导航栏 - 全局样式 ========== */
/* 迁移自 Dashboard，确保 Stats/Health/Profile 等页面可见 */

.bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    /* height: 140rpx;  Remove fixed height */
    background: #FFFFFF;
    border-top: 1rpx solid #F0FDF4;
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 16rpx 40rpx; /* Top padding */
    padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); /* Balanced padding bottom */
    z-index: 100;
    box-shadow: 0 -8rpx 32rpx rgba(16, 185, 129, 0.05);
}

.nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6rpx;
    flex: 1;
    position: relative;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.nav-item:active {
    transform: scale(0.95);
}

.nav-icon {
    width: 52rpx;
    height: 52rpx;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 首页图标 - 创意小屋 */
.icon-home {
    width: 52rpx;
    height: 52rpx;
    position: relative;
    border: 3rpx solid #D1D5DB;
    border-radius: 12rpx;
    box-sizing: border-box;
    transition: all 0.3s;
}

.icon-home::before {
    content: '';
    position: absolute;
    top: -12rpx;
    left: -3rpx; /* border width offset */
    width: 46rpx; /* width + 2*border */
    height: 24rpx;
    background: transparent;
    border-top: 3rpx solid #D1D5DB;
    border-left: 3rpx solid #D1D5DB;
    border-right: 3rpx solid #D1D5DB;
    border-radius: 12rpx 12rpx 0 0;
    box-sizing: border-box;
    transform: skewX(0deg); /* Placeholder for roof shape */
}

/* Re-implementing Home as a solid/outline style switch */
.icon-home {
    border: none; /* Reset base border */
    background: transparent;
}

.icon-home::before {
    /* Roof */
    content: '';
    position: absolute;
    top: 4rpx;
    left: 50%;
    transform: translateX(-50%);
    width: 36rpx;
    height: 36rpx;
    border-top: 4rpx solid #D1D5DB;
    border-left: 4rpx solid #D1D5DB;
    border-radius: 4rpx;
    transform: translateX(-50%) rotate(45deg);
    transition: all 0.3s;
    background: transparent;
    box-sizing: border-box;
}

.icon-home::after {
    /* Body */
    content: '';
    position: absolute;
    bottom: 4rpx;
    left: 50%;
    transform: translateX(-50%);
    width: 32rpx;
    height: 24rpx;
    border: 4rpx solid #D1D5DB;
    border-top: none;
    border-radius: 0 0 6rpx 6rpx;
    transition: all 0.3s;
    box-sizing: border-box;
}

/* Active State - Filled and Scaled */
.nav-item.active .icon-home::before {
    border-color: var(--primary-color);
    background: var(--primary-color);
    background: transparent; /* Keep outline for crisp look */
    border-width: 5rpx;
    filter: drop-shadow(0 4rpx 8rpx rgba(16, 185, 129, 0.3)); /* Soft glow */
}

.nav-item.active .icon-home::after {
    border-color: var(--primary-color);
    border-width: 5rpx;
    height: 22rpx;
}

/* 统计图标 - 动态柱状图 */
.icon-chart::before,
.icon-chart::after {
    content: '';
    position: absolute;
    bottom: 8rpx;
    width: 8rpx;
    border-radius: 4rpx;
    background: #D1D5DB;
    transition: all 0.3s;
}

.icon-chart::before {
    left: 10rpx;
    height: 20rpx;
    box-shadow: 14rpx -12rpx 0 #D1D5DB; /* Middle bar */
}

.icon-chart::after {
    right: 10rpx;
    height: 28rpx;
}

.nav-item.active .icon-chart::before {
    height: 24rpx; /* Animate height */
    background: var(--primary-color);
    box-shadow: 14rpx -6rpx 0 #F97316, 0 0 12rpx rgba(16, 185, 129, 0.4); /* Orange middle bar + Glow */
}

.nav-item.active .icon-chart::after {
    height: 36rpx;
    background: var(--primary-color);
}

/* 健康图标 - 灵动爱心 */
.icon-heart::before,
.icon-heart::after {
    content: "";
    position: absolute;
    top: 14rpx;
    width: 20rpx;
    height: 32rpx;
    border-radius: 20rpx 20rpx 0 0;
    background: #D1D5DB;
    transform: rotate(-45deg);
    transform-origin: 0 100%;
    left: 26rpx;
    transition: all 0.3s;
}

.icon-heart::after {
    left: 6rpx;
    transform: rotate(45deg);
    transform-origin: 100% 100%;
}

.nav-item.active .icon-heart::before,
.nav-item.active .icon-heart::after {
    background: var(--primary-color); /* Mint green heart */
    height: 34rpx; /* Pulse effect */
    top: 12rpx;
    filter: drop-shadow(0 4rpx 10rpx rgba(16, 185, 129, 0.4)); /* Heart glow */
}

/* 我的图标 - 现代Avatar */
.icon-user::before {
    content: '';
    position: absolute;
    width: 20rpx;
    height: 20rpx;
    border-radius: 50%;
    background: #D1D5DB; /* Solid head */
    top: 8rpx;
    left: 50%;
    transform: translateX(-50%);
    transition: all 0.3s;
}

.icon-user::after {
    content: '';
    position: absolute;
    width: 36rpx;
    height: 18rpx;
    border-radius: 18rpx 18rpx 0 0;
    background: #D1D5DB; /* Solid body */
    bottom: 6rpx;
    left: 50%;
    transform: translateX(-50%);
    transition: all 0.3s;
}

.nav-item.active .icon-user::before,
.nav-item.active .icon-user::after {
    background: var(--primary-color);
    box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.2);
}

.nav-text {
    font-size: 20rpx;
    color: #9CA3AF;
    font-weight: 500;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
}

.nav-item.active .nav-text {
    color: var(--primary-color);
    font-weight: 800; /* Extra bold */
    transform: translateY(-2rpx) scale(1.05); /* Slight pop */
    text-shadow: 0 0 20rpx rgba(16, 185, 129, 0.3); /* Text glow */
}

/* 中央相机按钮 - 现代化绿色主题 */
/* 中央相机按钮 - 现代化绿色主题 (Floating Hump Pro Max) */
.nav-camera {
    position: relative;
    top: -48rpx; /* Increased float height */
    z-index: 101;
}

.camera-button {
    width: 136rpx; /* Larger size */
    height: 136rpx;
    background: linear-gradient(135deg, #10B981 0%, #059669 100%); /* Deep Mint Gradient */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    
    /* Pro Max Glow & Depth */
    box-shadow: 0 12rpx 32rpx rgba(16, 185, 129, 0.5), 
                inset 0 2rpx 4rpx rgba(255,255,255,0.3);
    
    border: 8rpx solid #FFFFFF; /* White separation border */
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
}

.camera-button::before {
    content: '';
    position: absolute;
    inset: 0; /* Cover full area */
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 100%);
    border-radius: 50%;
    z-index: 1;
    opacity: 0;
    transition: all 0.3s;
}

.nav-camera:active .camera-button {
    transform: scale(0.92) translateY(4rpx); /* Tactile press effect */
    box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.4); /* Reduced shadow on press */
}

.nav-camera:active .camera-button::before {
    opacity: 1;
}

/* 相机图标 - 现代简约填充风格 */
.icon-camera {
    width: 56rpx;
    height: 48rpx;
    position: relative;
}

.icon-camera::before {
    content: '';
    position: absolute;
    width: 48rpx;
    height: 36rpx;
    background: #FFFFFF;
    border-radius: 10rpx;
    bottom: 2rpx;
    left: 4rpx;
    box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
}

.icon-camera::after {
    content: '';
    position: absolute;
    width: 20rpx;
    height: 20rpx;
    border: 4rpx solid var(--primary-color);
    border-radius: 50%;
    bottom: 10rpx;
    left: 18rpx;
    background: #FFFFFF;
    box-sizing: border-box;
}


/* ========== 全局组件：标准返回按钮 ========== */
.std-back-btn {
    width: 72rpx;
    height: 72rpx;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
    border: 1rpx solid rgba(0,0,0,0.05); /* Subtle border for contrast */
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    z-index: 50;
}

.std-back-btn:active {
    transform: scale(0.92);
    background: #F3F4F6;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* CSS绘制的精致箭头 */
.std-back-btn::after {
    content: '';
    width: 18rpx;
    height: 18rpx;
    border-top: 4rpx solid #374151; /* Gray-700 */
    border-left: 4rpx solid #374151;
    transform: rotate(-45deg);
    margin-left: 6rpx; /* Visual optical adjustment */
    margin-top: 2rpx;
}
