/* Landing页面样式 - 完全还原原始React设计 */

.landing-container {
    min-height: 100vh;
    background: #F9FAFB;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 64rpx;
    padding-bottom: 200rpx; 
    position: relative;
    animation: fadeIn 0.7s ease-out;
    box-sizing: border-box;
}

/* 滚动锁定 */
.landing-container.is-locked {
    height: 100vh;
    overflow: hidden;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

/* ========== 主内容区 ========== */
.main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* Logo容器 */
.logo-container {
    width: 256rpx;
    height: 256rpx;
    background: #111827;
    border-radius: 80rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 64rpx;
    box-shadow: 0 50rpx 100rpx -20rpx rgba(0, 0, 0, 0.15);
    overflow: hidden; /* 圆角裁剪 */
}

.logo-image {
    width: 100%;
    height: 100%;
}

/* 标题 */
.title {
    font-size: 80rpx;
    font-weight: 900;
    color: #111827;
    margin-bottom: 24rpx;
    letter-spacing: -2rpx;
}

/* 标语 */
.slogan {
    font-size: 36rpx;
    font-weight: 500;
    color: #6B7280;
    letter-spacing: 4rpx;
}

.bottom-actions {
    position: fixed;
    bottom: calc(48rpx + env(safe-area-inset-bottom));
    left: 64rpx;
    right: 64rpx;
    width: auto;
    z-index: 100;
}

/* 开始按钮 */
.start-btn {
    width: 100%;
    height: 112rpx;
    background: var(--primary-color);
    color: #FFFFFF;
    font-size: 36rpx;
    font-weight: 700;
    border-radius: 56rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20rpx 50rpx -10rpx rgba(16, 185, 129, 0.5);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.start-btn:active {
    transform: scale(0.98);
}

.start-btn.disabled {
    opacity: 0.6;
}

/* 登录链接 */
.login-link {
    text-align: center;
    margin: 48rpx 0;
    font-size: 28rpx;
    font-weight: 700;
    color: #111827;
    letter-spacing: 2rpx;
}

.login-link:active {
    color: #374151;
}

/* 协议行 */
.agreement-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24rpx;
    padding-top: 16rpx;
}

/* 复选框 */
.checkbox {
    width: 40rpx;
    height: 40rpx;
    border: 4rpx solid #D1D5DB;
    border-radius: 12rpx;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    flex-shrink: 0;
}

.checkbox.checked {
    background: var(--primary-color);
    border-color: var(--primary-color);
}

.check-icon {
    color: #FFFFFF;
    font-size: 24rpx;
    font-weight: 700;
}

/* 协议文本 */
.agreement-text {
    font-size: 24rpx;
    color: #9CA3AF;
    font-weight: 500;
}

.link {
    color: var(--primary-color);
    font-weight: 700;
    padding: 0 8rpx;
}

/* ========== 弹窗样式 ========== */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(8rpx);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32rpx;
    z-index: 1000;
    animation: fadeIn 0.3s ease-out;
}

.modal-container {
    width: 100%;
    max-width: 640rpx;
    max-height: 85vh;
    background: #FFFFFF;
    border-radius: 80rpx;
    box-shadow: 0 50rpx 100rpx rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(80rpx) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* 弹窗头部 */
.modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 40rpx 48rpx;
    border-bottom: 2rpx solid #F3F4F6;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(20rpx);
}

.modal-title-row {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.modal-icon {
    width: 64rpx;
    height: 64rpx;
    background: var(--primary-light);
    border-radius: 20rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32rpx;
}

.modal-title {
    font-size: 36rpx;
    font-weight: 900;
    color: #111827;
}

.close-btn {
    width: 64rpx;
    height: 64rpx;
    background: #F9FAFB;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32rpx;
    color: #9CA3AF;
}

.close-btn:active {
    background: #F3F4F6;
    color: #6B7280;
}

/* 弹窗内容 */
.modal-content {
    flex: 1;
    padding: 48rpx;
    overflow-y: auto;
}

.section {
    margin-bottom: 48rpx;
}

.section:last-child {
    margin-bottom: 0;
}

.section-title {
    font-size: 32rpx;
    font-weight: 700;
    color: #111827;
    margin-bottom: 16rpx;
}

.section-text {
    font-size: 28rpx;
    color: #6B7280;
    line-height: 1.7;
}

.section-list {
    display: flex;
    flex-direction: column;
    gap: 12rpx;
}

.list-item {
    display: flex;
    gap: 12rpx;
    font-size: 28rpx;
    color: #6B7280;
    line-height: 1.6;
}

.list-bullet {
    flex-shrink: 0;
    color: #9CA3AF;
}

.bold {
    font-weight: 700;
    color: #374151;
}

/* 警告框 */
.warning-box {
    background: #FFF7ED;
    border: 2rpx solid #FFEDD5;
    border-radius: 24rpx;
    padding: 32rpx;
    font-size: 28rpx;
    font-weight: 500;
    color: #C2410C;
    margin-bottom: 16rpx;
    line-height: 1.6;
}

/* 弹窗底部 */
.modal-footer {
    padding: 48rpx;
    border-top: 2rpx solid #F9FAFB;
    background: #FFFFFF;
}

.confirm-btn {
    width: 100%;
    height: 96rpx;
    background: #111827;
    color: #FFFFFF;
    font-size: 32rpx;
    font-weight: 700;
    border-radius: 32rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.1);
    transition: all 0.2s;
}

.confirm-btn:active {
    background: #000000;
    transform: scale(0.98);
}
