/* 页面容器 - 占满全屏 */
.page-wrapper {
  height: 100vh;
  width: 100vw;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f8fafc;
}

/* 滚动区域 */
.scroll-container {
  flex: 1;
  height: 100%;
  width: 100%;
}

.health-container {
  padding: 30rpx 40rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); /* 适配底部导航 */
  max-width: 750rpx;
  margin: 0 auto;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
  margin-bottom: 30rpx;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.back-arrow {
  font-size: 40rpx;
  color: #374151;
  font-weight: 300;
}

.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #111827;
}

.placeholder {
  width: 80rpx;
}

/* Banner */
.banner {
  position: relative;
  border-radius: 40rpx;
  padding: 40rpx;
  height: 320rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

.banner-challenge {
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  border: 2rpx solid #fff;
}

.banner-scanner {
  background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
  border: 2rpx solid #fff;
}

.banner-bg {
  position: absolute;
  right: -20rpx;
  bottom: -40rpx;
  font-size: 240rpx; /* 超大背景 Emoji */
  opacity: 0.15;
  filter: blur(2px);
}

.banner-content {
  position: relative;
  z-index: 2;
  width: 70%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

.banner-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
}

.tag-yellow { background: #fbbf24; color: #78350f; }
.tag-green { background: #22c55e; color: #fff; }

.banner-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #111827;
  margin-bottom: 12rpx;
}

.banner-desc {
  font-size: 24rpx;
  font-weight: 600;
  color: #6b7280;
  margin-bottom: 32rpx;
  line-height: 1.4;
}

.banner-btn {
  padding: 16rpx 32rpx;
  background: #111827;
  color: #fff;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.btn-green {
  background: #15803d;
}

/* Section */
.section {
  margin-top: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #111827;
  margin-bottom: 24rpx;
  display: block;
  padding-left: 8rpx;
}

/* Tools Grid */
.tools-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}


