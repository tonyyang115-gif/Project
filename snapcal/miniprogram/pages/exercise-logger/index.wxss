.exercise-logger {
  min-height: 100vh;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background: #fff;
  border-bottom: 1px solid #f1f5f9;
}

.cancel-btn {
  font-size: 14px;
  font-weight: 700;
  color: #6b7280;
  padding: 8px 0;
}

.header-title {
  font-size: 18px;
  font-weight: 800;
  color: #111827;
}

.save-btn {
  font-size: 14px;
  font-weight: 700;
  color: #fff;
  background: #2563eb;
  padding: 8px 16px;
  border-radius: 20px;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
}

/* Content */
.content {
  flex: 1;
  padding: 20px;
  padding-bottom: calc(20px + env(safe-area-inset-bottom));
}

/* Types Grid */
.types-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  margin-bottom: 24px;
}

.type-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12px 8px;
  background: #fff;
  border: 2px solid #f1f5f9;
  border-radius: 16px;
  transition: all 0.2s;
}

.type-card.active {
  border-color: #2563eb;
  background: #eff6ff;
}

.type-icon {
  font-size: 24px;
  margin-bottom: 8px;
}

.type-name {
  font-size: 10px;
  font-weight: 700;
  color: #6b7280;
  text-align: center;
  white-space: nowrap;
}

.type-card.active .type-name {
  color: #1e40af;
}

/* Input Card */
.input-card {
  background: #f8fafc;
  padding: 20px;
  border-radius: 24px;
  border: 1px solid #f1f5f9;
  margin-bottom: 16px;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.card-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.card-icon {
  font-size: 20px;
}

.card-label {
  font-size: 14px;
  font-weight: 700;
  color: #374151;
}

.card-label.orange {
  color: #c2410c;
}

.edit-tag {
  font-size: 10px;
  font-weight: 700;
  color: #f97316;
  background: rgba(255, 255, 255, 0.5);
  padding: 4px 8px;
  border-radius: 8px;
}

.slider-wrap {
  display: flex;
  align-items: center;
  gap: 16px;
}

.slider-wrap slider {
  flex: 1;
}

.slider-value {
  display: flex;
  align-items: baseline;
  gap: 4px;
  min-width: 70px;
  text-align: right;
}

.value-num {
  font-size: 28px;
  font-weight: 800;
  color: #111827;
}

.value-unit {
  font-size: 12px;
  font-weight: 700;
  color: #9ca3af;
}

/* Calorie Card */
.calorie-card {
  background: #fff7ed;
  padding: 20px;
  border-radius: 24px;
  border: 1px solid #fed7aa;
}

.calorie-input-wrap {
  display: flex;
  justify-content: center;
  margin: 16px 0;
}

.calorie-input {
  width: 100%;
  text-align: center;
  font-size: 48px;
  font-weight: 800;
  color: #ea580c;
  background: transparent;
  border-bottom: 2px solid transparent;
  padding-bottom: 8px;
}

.calorie-input:focus {
  border-bottom-color: #fed7aa;
}

.estimate-text {
  display: block;
  text-align: center;
  font-size: 12px;
  font-weight: 600;
  color: #fb923c;
}
