/* Profile页面样式 - Flex布局配合 scroll-view */
.profile-container {
    height: 100vh;
    width: 100vw;
    display: flex;
    flex-direction: column;
    overflow: hidden; /* 防止原生页面滚动冲突 */
    background: #F9FAFB;
}

/* 滚动区域 */
.scroll-view {
    flex: 1;
    height: 0; /* 关键：允许 flex 压缩/伸展 */
    width: 100%;
}

.scroll-content-wrapper {
    /* 保持原样或增加一点顶部留白 */
    width: 100%;
}

/* ========== 主页面Header ========== */
.header {
    padding-top: calc(env(safe-area-inset-top) + 32rpx);
    padding-bottom: 32rpx;
    padding-left: 48rpx;
    padding-right: 48rpx;
    text-align: center;
}

.header-title {
    font-size: 40rpx;
    font-weight: 900;
    color: #111827;
    letter-spacing: 1rpx;
    line-height: 1.2;
}

/* ========== 子页面Header ========== */
.sub-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: calc(env(safe-area-inset-top) + 32rpx);
    padding-bottom: 32rpx;
    padding-left: 48rpx;
    padding-right: 48rpx;
}

.back-btn {
    font-size: 48rpx;
    color: #374151;
    padding: 16rpx;
}

.sub-title {
    font-size: 40rpx;
    font-weight: 900;
    color: #111827;
    letter-spacing: 1rpx;
    line-height: 1.2;
}

.save-btn {
    font-size: 28rpx;
    font-weight: 700;
    color: var(--primary-color);
    padding: 16rpx;
}

/* ========== 内容区 ========== */
.content {
    padding: 0 40rpx;
    padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* ========== 用户卡片 ========== */
.user-card {
    background: #FFFFFF;
    border-radius: 64rpx;
    padding: 48rpx;
    margin-bottom: 40rpx;
    box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.03);
}

.user-info {
    display: flex;
    align-items: center;
    gap: 32rpx;
    margin-bottom: 48rpx;
}

.avatar {
    width: 160rpx;
    height: 160rpx;
    background: #D1F2E2;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border: 8rpx solid #FFFFFF;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
    overflow: hidden; /* Ensure image clipping */
}

.avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: block; /* Remove inline spacing */
}

.avatar-text {
    font-size: 60rpx;
    font-weight: 700;
    color: var(--primary-color);
}

.edit-icon {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 48rpx;
    height: 48rpx;
    background: #FFFFFF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24rpx;
    color: #9CA3AF;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.user-text {
    flex: 1;
}

.user-name {
    font-size: 44rpx;
    font-weight: 900;
    color: #111827;
    display: block;
    margin-bottom: 8rpx;
}

.user-hint {
    font-size: 24rpx;
    color: #9CA3AF;
    font-weight: 500;
}

/* 统计行 */
.stats-row {
    display: flex;
    border-top: 2rpx solid #F3F4F6;
    padding-top: 48rpx;
}

.stat-item {
    flex: 1;
    text-align: center;
}

.stat-icon {
    width: 96rpx;
    height: 96rpx;
    border-radius: 32rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24rpx;
    font-size: 48rpx;
}

.stat-icon.blue { background: #D1F2E2; }
.stat-icon.green { background: #F0FDF4; }
.stat-icon.purple { background: #F5F3FF; }

.stat-value {
    font-size: 40rpx;
    font-weight: 900;
    color: #111827;
    display: block;
    margin-bottom: 8rpx;
}

.stat-label {
    font-size: 24rpx;
    color: #9CA3AF;
    font-weight: 700;
}

/* ========== 菜单卡片 ========== */
.menu-card {
    background: #FFFFFF;
    border-radius: 64rpx;
    padding: 32rpx 16rpx;
    margin-bottom: 32rpx;
    box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.03);
}

.menu-title {
    font-size: 32rpx;
    font-weight: 900;
    color: #111827;
    padding: 16rpx 32rpx;
    display: block;
}

.menu-item {
    display: flex;
    align-items: center;
    padding: 32rpx;
    border-top: 2rpx solid #F9FAFB;
}

.menu-icon {
    width: 80rpx;
    height: 80rpx;
    border-radius: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40rpx;
    margin-right: 32rpx;
}

.menu-icon.blue { background: var(--primary-light); }
.menu-icon.pink { background: #FDF2F8; }
.menu-icon.gray { background: #F3F4F6; }

.menu-label {
    flex: 1;
    font-size: 28rpx;
    font-weight: 700;
    color: #111827;
}

.menu-arrow {
    font-size: 40rpx;
    color: #D1D5DB;
}

/* ========== 表单卡片 ========== */
.form-card {
    background: #FFFFFF;
    border-radius: 64rpx;
    padding: 16rpx 32rpx;
    margin-bottom: 32rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.02);
}

.form-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32rpx 16rpx;
    border-bottom: 2rpx solid #F9FAFB;
}

.form-row:last-child {
    border-bottom: none;
}

.form-label {
    font-size: 28rpx;
    font-weight: 700;
    color: #374151;
}

.form-input {
    text-align: right;
    font-size: 28rpx;
    font-weight: 500;
    color: #111827;
    width: 300rpx;
}

/* 性别切换 */
.gender-toggle {
    display: flex;
    background: #F3F4F6;
    border-radius: 16rpx;
    padding: 4rpx;
}

.gender-btn {
    padding: 16rpx 32rpx;
    font-size: 24rpx;
    font-weight: 700;
    color: #9CA3AF;
    border-radius: 12rpx;
    transition: all 0.2s;
}

.gender-btn.active {
    background: #FFFFFF;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.gender-btn.active.male { color: var(--primary-color); }
.gender-btn.active.female { color: #EC4899; }

/* 调整器 */
.adjuster {
    display: flex;
    align-items: center;
    gap: 24rpx;
}

.adj-btn {
    width: 48rpx;
    height: 48rpx;
    background: #F3F4F6;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32rpx;
    color: #6B7280;
}

.adj-value {
    font-size: 28rpx;
    font-weight: 700;
    color: #111827;
    width: 80rpx;
    text-align: center;
}

/* ========== 目标体重卡片 ========== */
.target-card {
    background: #FFFFFF;
    border-radius: 64rpx;
    padding: 48rpx;
    margin-bottom: 48rpx;
    text-align: center;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.02);
}

.target-label {
    font-size: 24rpx;
    font-weight: 700;
    color: #9CA3AF;
    text-transform: uppercase;
    letter-spacing: 4rpx;
}

.target-adjuster {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 48rpx;
    margin: 32rpx 0;
}

.adj-btn-large {
    width: 80rpx;
    height: 80rpx;
    background: #F9FAFB;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40rpx;
    color: #6B7280;
}

.target-value {
    display: flex;
    align-items: baseline;
}

.target-number {
    font-size: 72rpx;
    font-weight: 900;
    color: #111827;
}

.target-unit {
    font-size: 28rpx;
    color: #9CA3AF;
    margin-left: 8rpx;
}

/* ========== 分区 ========== */
.section {
    margin-bottom: 48rpx;
}

.section-title {
    font-size: 28rpx;
    font-weight: 700;
    color: #111827;
    margin-bottom: 24rpx;
    padding-left: 16rpx;
}

/* 目标网格 */
.goal-grid {
    display: flex;
    gap: 24rpx;
}

.goal-btn {
    flex: 1;
    padding: 24rpx;
    background: #FFFFFF;
    border: 4rpx solid #FFFFFF;
    border-radius: 24rpx;
    text-align: center;
    font-size: 24rpx;
    font-weight: 700;
    color: #6B7280;
    transition: all 0.2s;
}

.goal-btn.active {
    border-color: var(--primary-color);
    background: var(--primary-light);
    color: var(--primary-dark);
}

/* 饮食网格 */
.diet-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24rpx;
}

.diet-btn {
    padding: 32rpx;
    background: #FFFFFF;
    border: 4rpx solid #FFFFFF;
    border-radius: 24rpx;
    position: relative;
    transition: all 0.2s;
}

.diet-btn.active {
    border-color: var(--primary-color);
    background: var(--primary-light);
}

.diet-name {
    font-size: 28rpx;
    font-weight: 700;
    color: #111827;
}

.check {
    position: absolute;
    top: 24rpx;
    right: 24rpx;
    color: var(--primary-color);
    font-size: 28rpx;
}

/* 热量卡片 */
.calories-card {
    background: #FFFFFF;
    border-radius: 64rpx;
    padding: 40rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.02);
}

.calories-label {
    font-size: 28rpx;
    font-weight: 700;
    color: #111827;
    display: block;
    margin-bottom: 16rpx;
}

.calories-input-wrap {
    position: relative;
}

.calories-input {
    width: 100%;
    height: 96rpx; /* Fixed height for consistency */
    background: #F9FAFB;
    border-radius: 24rpx;
    padding: 0 120rpx 0 32rpx; /* Horizontal padding only */
    font-size: 40rpx;
    font-weight: 900;
    color: #111827;
    line-height: 96rpx; /* Vertical centering */
}

.calories-unit {
    position: absolute;
    right: 32rpx;
    top: 50%;
    transform: translateY(-50%);
    font-size: 28rpx;
    font-weight: 700;
    color: #9CA3AF;
}

.calories-hint {
    font-size: 24rpx;
    color: #9CA3AF;
    margin-top: 16rpx;
    padding-left: 8rpx;
}

/* ========== FAQ卡片 ========== */
.faq-card {
    background: #FFFFFF;
    border-radius: 48rpx;
    padding: 8rpx 32rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.02);
}

.faq-item-wrap {
    border-bottom: 2rpx solid #F9FAFB;
}

.faq-item-wrap:last-child {
    border-bottom: none;
}

.faq-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32rpx 16rpx;
}

.faq-question {
    flex: 1;
    font-size: 28rpx;
    font-weight: 600;
    color: #374151;
}

.faq-arrow {
    color: #D1D5DB;
    font-size: 32rpx;
    transition: transform 0.2s;
    width: 40rpx;
    text-align: center;
}

.faq-arrow.open {
    color: #9CA3AF;
    transform: rotate(180deg);
}

.faq-answer {
    max-height: 0;
    overflow: hidden;
    padding: 0 16rpx;
    transition: max-height 0.3s ease, padding 0.3s ease;
}

.faq-answer.show {
    max-height: 300rpx;
    padding: 0 16rpx 32rpx;
}

.faq-answer text {
    font-size: 26rpx;
    color: #6B7280;
    line-height: 1.6;
}

/* 反馈卡片 */
.feedback-card {
    background: #FFFFFF;
    border-radius: 48rpx;
    padding: 40rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.02);
}

.feedback-card.native {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.feedback-desc {
    font-size: 28rpx;
    color: #6B7280;
    margin-bottom: 32rpx;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
}

.submit-btn {
    width: 100%;
    height: 112rpx;
    background: var(--primary-color);
    color: #FFFFFF;
    border-radius: 56rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
    box-shadow: 0 20rpx 50rpx -10rpx rgba(16, 185, 129, 0.5);
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
        box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1),
        opacity 0.2s ease;
}

.submit-btn:active {
    transform: scale(0.98);
    box-shadow: 0 12rpx 30rpx -10rpx rgba(16, 185, 129, 0.4);
}

.submit-btn.native-feedback {
    width: 100% !important; /* Override default button styles */
    margin: 0 !important;
    padding: 0 !important;
    font-weight: 700 !important;
}

.submit-btn.native-feedback::after {
    border: none;
}

/* 版本信息 */
.version {
    text-align: center;
    padding: 64rpx 48rpx;
    font-size: 24rpx;
    color: #D1D5DB;
    font-weight: 700;
}

/* =========================================
   Avatar Edit UI Styles (Replication Fix)
   ========================================= */

.avatar-edit-card {
    background: #fff;
    border-radius: 48rpx;
    padding: 48rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 40rpx;
    width: 100%;
    box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.02);
}

.avatar-wrapper {
    padding: 0;
    width: 180rpx !important;
    height: 180rpx !important;
    border-radius: 50%;
    background: #f3f4f6;
    margin-bottom: 24rpx;
    position: relative;
    overflow: visible;
    box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
}

.avatar-wrapper::after { border: none; }

.avatar-preview {
    width: 180rpx;
    height: 180rpx;
    border-radius: 50%;
    background: #e5e7eb;
}

.edit-badge {
    position: absolute;
    bottom: 0;
    right: 0;
    background: #111827; /* Dark Gray for Pencil Badge */
    width: 56rpx;
    height: 56rpx;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32rpx;
    border: 4rpx solid #fff;
    color: #fff;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

.avatar-tip {
    font-size: 28rpx;
    color: #6b7280;
    margin-bottom: 56rpx;
    font-weight: 500;
}

/* 推荐头像区域 */
.recommend-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.recommend-title {
    font-size: 28rpx;
    color: #9ca3af;
    margin-bottom: 32rpx;
    padding-left: 48rpx; /* Align with card content */
    font-weight: 700;
}

.avatar-scroll-view {
    width: 100%;
    white-space: nowrap;
    padding: 16rpx 0; /* Vertical padding to prevent shadow clipping */
}

.avatar-scroll-list {
    display: flex;
    padding: 0 48rpx; /* Inner padding for scroll start/end */
    align-items: center;
}

.default-avatar-item {
    display: inline-block;
    position: relative;
    margin-right: 32rpx;
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
}

.def-avatar-img {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    background: transparent; /* Transparent to let SVG color show */
    transition: all 0.2s ease;
}

/* Offset Ring Selection Effect (Blue Theme) */
.default-avatar-item.active .def-avatar-img {
    /* White gap (6rpx) + Blue Ring (6rpx) = 12rpx total spread */
    box-shadow: 0 0 0 6rpx #fff, 0 0 0 12rpx #4F46E5;
    transform: scale(0.92); /* Shrink slightly to accommodate ring */
}

.selected-mark {
    position: absolute;
    bottom: -6rpx;
    right: -6rpx;
    background: #4F46E5; /* Blue Badge */
    width: 48rpx;
    height: 48rpx;
    border-radius: 50%;
    border: 4rpx solid #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 28rpx;
    font-weight: 900;
    box-shadow: 0 4rpx 12rpx rgba(79, 70, 229, 0.4);
    z-index: 10;
}

/* ========== 菜单图标颜色扩展 ========== */
.menu-icon.orange { background: #FFF7ED; }
.menu-icon.teal { background: #F0FDFA; }

/* ========== 数据管理页面 ========== */
.data-mgmt-card {
    background: #FFFFFF;
    border-radius: 48rpx;
    overflow: hidden;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.02);
}

.data-mgmt-item {
    display: flex;
    align-items: center;
    padding: 40rpx;
    border-bottom: 2rpx solid #F9FAFB;
}

.data-mgmt-item:last-child {
    border-bottom: none;
}

.data-mgmt-icon {
    width: 80rpx;
    height: 80rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40rpx;
    margin-right: 32rpx;
    background: #F9FAFB;
    border-radius: 24rpx;
    flex-shrink: 0;
}

.data-mgmt-info {
    flex: 1;
}

.data-mgmt-label {
    font-size: 28rpx;
    font-weight: 700;
    color: #111827;
    display: block;
    margin-bottom: 8rpx;
}

.data-mgmt-desc {
    font-size: 22rpx;
    color: #9CA3AF;
    font-weight: 500;
}

.data-warning {
    text-align: center;
    padding: 48rpx 32rpx;
    font-size: 24rpx;
    color: #D1D5DB;
    font-weight: 500;
}

/* ========== 关于页面 ========== */
.about-logo-card {
    background: #FFFFFF;
    border-radius: 48rpx;
    padding: 64rpx 40rpx;
    margin-bottom: 32rpx;
    text-align: center;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.02);
    display: flex;
    flex-direction: column;
    align-items: center;
}

.about-logo-img {
    width: 160rpx;
    height: 160rpx;
    border-radius: 32rpx;
    margin-bottom: 24rpx;
}

.about-name {
    font-size: 44rpx;
    font-weight: 900;
    color: #111827;
    margin-bottom: 8rpx;
}

.about-version {
    font-size: 26rpx;
    font-weight: 700;
    color: #9CA3AF;
    margin-bottom: 24rpx;
}

.about-slogan {
    font-size: 26rpx;
    color: #6B7280;
    font-weight: 500;
}

/* 产品特色卡片 */
.about-features-card {
    background: #FFFFFF;
    border-radius: 48rpx;
    padding: 16rpx 40rpx;
    margin-bottom: 32rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.02);
}

.about-feature-item {
    display: flex;
    align-items: center;
    padding: 28rpx 0;
    border-bottom: 2rpx solid #F9FAFB;
}

.about-feature-item:last-child {
    border-bottom: none;
}

.about-feature-icon {
    font-size: 40rpx;
    width: 72rpx;
    height: 72rpx;
    background: #F9FAFB;
    border-radius: 20rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 28rpx;
    flex-shrink: 0;
}

.about-feature-text {
    flex: 1;
}

.about-feature-title {
    font-size: 28rpx;
    font-weight: 700;
    color: #111827;
    display: block;
    margin-bottom: 4rpx;
}

.about-feature-desc {
    font-size: 22rpx;
    color: #9CA3AF;
    font-weight: 500;
}

/* 使用统计卡片 */
.about-stats-card {
    background: #FFFFFF;
    border-radius: 48rpx;
    padding: 40rpx;
    margin-bottom: 32rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.02);
    display: flex;
    align-items: center;
}

.about-stat-item {
    flex: 1;
    text-align: center;
}

.about-stat-value {
    font-size: 48rpx;
    font-weight: 900;
    color: #111827;
    display: block;
    margin-bottom: 8rpx;
}

.about-stat-label {
    font-size: 22rpx;
    color: #9CA3AF;
    font-weight: 600;
}

.about-stat-divider {
    width: 2rpx;
    height: 64rpx;
    background: #F3F4F6;
}

.about-id {
    font-family: monospace;
    font-size: 24rpx;
}

.about-footer {
    text-align: center;
    padding: 64rpx 48rpx 32rpx;
    font-size: 22rpx;
    color: #D1D5DB;
    font-weight: 500;
}
