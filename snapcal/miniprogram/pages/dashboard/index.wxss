/* ========== 统一饮食记录弹窗 (底部抽屉) ========== */

.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 2000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease;
}

.modal-overlay.show {
    opacity: 1;
    visibility: visible;
}

.bottom-sheet {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #FFFFFF;
    border-radius: 40rpx 40rpx 0 0;
    padding: 40rpx;
    padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
    z-index: 2001;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    max-height: 85vh; /* 防止超高 */
}

.bottom-sheet.show {
    transform: translateY(0);
}

/* 1. 头部 */
.log-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32rpx;
}

.header-btn {
    font-size: 28rpx;
    padding: 12rpx 24rpx;
    border-radius: 32rpx;
}

.header-btn.cancel {
