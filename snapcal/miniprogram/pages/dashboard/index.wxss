    font-weight: bold;
}

.header-title {
    font-size: 36rpx;
    font-weight: 800;
    color: #111827;
}

/* 2. Tabs - 重新设计图标 */
.log-tabs {
    display: flex;
    background: #F3F4F6;
    border-radius: 24rpx;
    padding: 8rpx;
    margin-bottom: 32rpx;
}

.tab-item {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12rpx;
    padding: 20rpx 0;
    border-radius: 20rpx;
    font-size: 28rpx;
    color: #9CA3AF;
    font-weight: bold;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.tab-item.active {
    background: #FFFFFF;
    color: var(--primary-dark); 
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.tab-icon {
    width: 36rpx;
    height: 36rpx;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Icon A: Camera (CSS Drawn) */
.tab-icon.camera::before {
    content: '';
    position: absolute;
    width: 32rpx;
    height: 24rpx;
    border: 3rpx solid currentColor;
    border-radius: 6rpx;
    bottom: 4rpx;
}
.tab-icon.camera::after {
    content: '';
    position: absolute;
    width: 12rpx;
    height: 12rpx;
    border: 3rpx solid currentColor;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -10%);
}

/* Icon B: Search (CSS Drawn) */
.tab-icon.search::before {
    content: '';
    position: absolute;
    width: 24rpx;
    height: 24rpx;
    border: 3rpx solid currentColor;
    border-radius: 50%;
    top: 2rpx;
    left: 2rpx;
}
.tab-icon.search::after {
    content: '';
    position: absolute;
    width: 10rpx;
    height: 3rpx;
    background: currentColor;
    bottom: 6rpx;
    right: 4rpx;
    transform: rotate(45deg);
    border-radius: 2rpx;
}

/* Icon C: Pen (CSS Drawn) */
.tab-icon.pen::before {
    content: '';
    position: absolute;
    width: 4rpx;
    height: 24rpx;
    background: currentColor;
    transform: rotate(45deg);
    top: 4rpx;
    right: 8rpx;
    border-radius: 2rpx;
    box-shadow: -6rpx 6rpx 0 currentColor; /* Double line handle */
}
.tab-icon.pen::after {
    content: '';
    position: absolute;
    width: 0;
    height: 0;
    border-left: 6rpx solid transparent;
    border-right: 6rpx solid transparent;
    border-top: 10rpx solid currentColor;
    bottom: 2rpx;
    left: 4rpx;
    transform: rotate(45deg);
}

/* 3. 餐次选择 */
.meal-selector {
    display: flex;
    gap: 24rpx;
    margin-bottom: 48rpx;
    overflow-x: auto; /* 允许横向滚动（虽然现在可能够放） */
    padding-bottom: 4rpx;
}

.meal-pill {
    padding: 16rpx 40rpx;
    border-radius: 40rpx;
    font-size: 28rpx;
    font-weight: 800;
    background: #F9FAFB;
    color: #9CA3AF;
    transition: all 0.2s ease;
    border: none; /*移除边框，更现代*/
}

.meal-pill.active {
    background: #111827;
    color: #FFFFFF;
    box-shadow: 0 8rpx 20rpx rgba(17, 24, 39, 0.2);
    transform: translateY(-2rpx);
}

/* 4. 内容区域 */
.log-content-area {
    /* 主要是为了承载不同模式的内容 */
}

/* 模式A: 拍照 */
.camera-trigger {
    border: 4rpx dashed #E5E7EB; /* Lighter dashed line */
    border-radius: 40rpx;
    height: 480rpx; /* Taller area */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #F9FAFB;
    transition: all 0.3s;
}

.camera-trigger:active {
    background: #F3F4F6;
    border-color: #D1D5DB;
}

/* 大相机图标容器 */
.camera-circle {
    width: 160rpx;
    height: 160rpx;
    background: #FFFFFF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 32rpx;
    box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.05); /* Soft shadow bubble */
    position: relative;
}

/* CSS Drawn Large Camera */
.camera-icon-lg {
    width: 80rpx;
    height: 64rpx;
    position: relative;
    color: var(--primary-color); /* Mint brand color */
}

.camera-icon-lg::before {
    /* Camera Body */
    content: '';
    position: absolute;
    inset: 0;
    border: 5rpx solid currentColor;
    border-radius: 16rpx;
    background: rgba(16, 185, 129, 0.05); /* Tint */
}

.camera-icon-lg::after {
    /* Lens */
    content: '';
    position: absolute;
    width: 32rpx;
    height: 32rpx;
    border: 5rpx solid currentColor;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.8) inset; /* Gap */
}

/* Top button hint */
.camera-circle::after {
    content: '';
    position: absolute;
    top: 40rpx;
    right: 46rpx;
    width: 10rpx;
    height: 6rpx;
    background: var(--primary-color);
    border-radius: 4rpx;
}

.camera-text {
    font-size: 36rpx;
    font-weight: 900;
    color: #1F2937;
    margin-bottom: 12rpx;
}

.camera-subtext {
    font-size: 26rpx;
    color: #9CA3AF;
    font-weight: 600;
}

/* 模式B: 搜索 */
.search-box {
    display: flex;
    align-items: center;
    background: #F9FAFB;
    padding: 32rpx;
    border-radius: 32rpx;
    gap: 24rpx;
    border: 2rpx solid transparent;
    transition: all 0.3s;
}

.search-box:focus-within {
    background: #FFFFFF;
    border-color: var(--primary-color);
    box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.1);
}

/* CSS Search Icon Small */
.search-icon-sm {
    width: 32rpx;
    height: 32rpx;
    position: relative;
    color: #9CA3AF;
}

.search-box:focus-within .search-icon-sm {
    color: var(--primary-color);
}

.search-icon-sm::before {
    content: '';
    position: absolute;
    width: 24rpx;
    height: 24rpx;
    border: 4rpx solid currentColor;
    border-radius: 50%;
    top: 0;
    left: 0;
}

.search-icon-sm::after {
    content: '';
    position: absolute;
    width: 10rpx;
    height: 4rpx;
    background: currentColor;
    bottom: 2rpx;
    right: 0;
    transform: rotate(45deg);
    border-radius: 4rpx;
}

/* 模式C: 手动输入 */
.manual-mode {
    display: flex;
    flex-direction: column;
    gap: 32rpx;
}

.form-row {
    display: flex;
    gap: 24rpx;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 12rpx;
}

.form-group.grow {
    flex: 1;
}

.form-group.half {
    width: 48%; /* Slightly less than 50 to accommodate gap */
}

.label {
    font-size: 24rpx;
    font-weight: bold;
    color: #9CA3AF;
}

.input-underline {
    border-bottom: 2rpx solid #E5E7EB;
    padding: 16rpx 0;
    font-size: 40rpx;
    font-weight: bold;
    color: #111827;
}

.input-underline:focus {
    border-bottom-color: #3B82F6;
}

.input-box {
    background: #F9FAFB;
    height: 88rpx;
    border-radius: 16rpx;
    padding: 0 24rpx;
    font-size: 32rpx;
    font-weight: bold;
    color: #111827;
    text-align: center;
}

.text-input-box {
    height: 112rpx;
    background: #F3F4F6;
    border-radius: 24rpx;
    padding: 0 32rpx;
    font-size: 32rpx;
    font-weight: bold;
    box-sizing: border-box;
    width: 100%;
    color: #111827;
}

/* 热量特殊样式 */
.calories-input-wrapper {
    background: #FFF7ED; /* Orange 50 */
    height: 100rpx;
    border-radius: 20rpx;
    display: flex;
    align-items: center;
    padding: 0 32rpx;
    justify-content: space-between;
}

.input-calories {
    font-size: 48rpx;
    font-weight: 800;
    color: #EA580C; /* Orange 600 */
    flex: 1;
    height: 100%;
}

.flame-suffix {
    font-size: 40rpx;
    color: #F97316;
}

/* 宏量营养素 */
.macros-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24rpx;
}

.macro-input-group {
    display: flex;
    flex-direction: column;
    gap: 12rpx;
    align-items: center;
}

.macro-input-group .input-box {
    width: 100%;
    text-align: center;
}

/* 底部按钮 */
.add-list-btn {
    background: #6B7280; /* Gray 500 */
    color: #FFFFFF;
    border-radius: 20rpx;
    height: 100rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32rpx;
    font-weight: bold;
    margin-top: 16rpx;
    width: 100% !important; /* Override button default width */
}

/* ========== 运动记录弹窗专属样式 ========== */

/* 1. 运动类型网格 */
.exercise-type-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20rpx;
    margin-bottom: 40rpx;
}

.exercise-grid-item {
    aspect-ratio: 1;
    background: #FFFFFF;
    border: 2rpx solid #F3F4F6;
    border-radius: 32rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12rpx;
    transition: all 0.2s;
}

.exercise-grid-item.active {
    border-color: #2563EB; /* Blue border */
    background: #EFF6FF;   /* Light Blue bg */
    box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.1);
}

.grid-icon {
    font-size: 40rpx;
}

.grid-name {
    font-size: 24rpx;
    color: #6B7280;
    font-weight: bold;
}

.exercise-grid-item.active .grid-name {
    color: #2563EB;
}

/* 2. 通用卡片容器 */
.exercise-card {
    background: #FFFFFF;
    border-radius: 40rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
    border: 1rpx solid #F9FAFB;
}

.card-title-row {
    display: flex;
    align-items: center;
    gap: 12rpx;
    margin-bottom: 24rpx;
}

.card-icon {
    font-size: 32rpx;
}

.card-title {
    font-size: 28rpx;
    font-weight: 800;
    color: #374151;
}

/* 3. 时长滑块 */
.duration-card {
    background: #F9FAFB; /* Slightly grey for contrast */
}

.slider-row {
    display: flex;
    align-items: center;
    gap: 24rpx;
}

.duration-slider {
    flex: 1;
    margin: 0; 
}

.duration-display {
    display: flex;
    align-items: baseline;
    gap: 4rpx;
    min-width: 120rpx;
    justify-content: flex-end;
}

.duration-val {
    font-size: 48rpx;
    font-weight: 800;
    color: #111827;
    font-family: var(--font-number);
}

.duration-unit {
    font-size: 24rpx;
    color: #9CA3AF;
    font-weight: bold;
}

/* 4. 结果卡片 (优化版) */
.result-card {
    background: #FFF7ED; /* Orange 50 */
    border: 2rpx solid #FFEDD5;
}

.result-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24rpx;
}

.result-info {
    display: flex;
    flex-direction: column;
}

.result-label {
    font-size: 28rpx;
    font-weight: 800;
    color: #9A3412; /* Darker Orange */
}

.result-sub {
    font-size: 22rpx;
    color: #F97316;
    margin-top: 4rpx;
    opacity: 0.8;
}

.result-input-group {
    display: flex;
    align-items: center;
    gap: 8rpx;
    border-bottom: 2rpx dashed #F97316; /* Dashed line indicates editable */
    padding-bottom: 4rpx;
}

.calories-huge-input {
    font-size: 64rpx; /* Slightly smaller but still hero */
    font-weight: 800;
    color: #C2410C;
    text-align: right;
    width: 140rpx;
    height: 80rpx;
    font-family: var(--font-number);
}

.edit-icon {
    font-size: 28rpx;
    opacity: 0.6;
}

.result-divider {
    height: 2rpx;
    background: rgba(249, 115, 22, 0.1);
