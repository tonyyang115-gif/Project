    align-items: center;
    gap: 8rpx;
    font-size: 22rpx;
    color: #C2410C;
    opacity: 0.7;
    font-weight: 500;
}

/* 5. 滚动区域特别处理 */
.exercise-scroll-content {
    max-height: 75vh;
