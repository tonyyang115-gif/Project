}

.purple-bar {
    background: #A855F7;
}

.blue-bar {
    background: #07C160;
}

.orange-bar {
    background: #F97316;
}

/* ========== 餐次记录列表 ========== */
.meals-list {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.meal-section {
    background: #ffffff;
    border-radius: 48rpx;
