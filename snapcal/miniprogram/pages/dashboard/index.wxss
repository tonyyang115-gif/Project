}

.btn-icon {
    font-size: 24rpx;
}

.btn-text {
    font-size: 20rpx;
}

.text-orange-600 { color: #EA580C; }
.text-blue-600 { color: #059669; }
.text-indigo-600 { color: #4F46E5; }
.text-pink-600 { color: #DB2777; }

.btn-secondary {
