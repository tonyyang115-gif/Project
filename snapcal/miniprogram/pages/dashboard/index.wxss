/* Dashboard 页面样式 - 完全还原原始设计 */

.dashboard {
    padding: 30rpx 40rpx;
    padding-top: calc(env(safe-area-inset-top) + 100rpx); /* Clear the Capsule Button area */
    padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
    max-width: 750rpx;
    margin: 0 auto;
    background: #F9FAFB;
    min-height: 100vh;
    /* transition: filter 0.3s; 可选：背景模糊 */
}

/* 滚动锁定类 */
.dashboard.is-locked {
    height: 100vh;
    overflow: hidden;
}

/* ========== 顶部Header ========== */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 48rpx;
}

.user-info {
    display: flex;
    align-items: center;
    gap: 24rpx;
}

.avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    background: #E5E7EB;
    overflow: hidden;
    border: 4rpx solid #ffffff;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.avatar-img {
    width: 100%;
    height: 100%;
}

.avatar-placeholder {
    width: 100%;
    height: 100%;
    background: #E8F8F0;
    color: #059669;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 32rpx;
}


/* ========== AI 扫描全屏动画 ========== */
.scanning-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: #000;
    z-index: 999;
    padding-top: env(safe-area-inset-top);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
}

.scanning-overlay.show {
    opacity: 1;
    pointer-events: auto;
}

.scan-container {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.scan-img {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0.6; /* Dim the image */
    filter: blur(10px);
}

.scan-grid {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: 
        linear-gradient(rgba(16, 185, 129, 0.2) 1px, transparent 1px),
        linear-gradient(90deg, rgba(16, 185, 129, 0.2) 1px, transparent 1px);
    background-size: 80rpx 80rpx;
    z-index: 2;
}

.scan-line {
    position: absolute;
    width: 100%;
    height: 4rpx;
    background: #34D399;
    box-shadow: 0 0 20rpx #10B981;
    z-index: 3;
    animation: scanMove 2s infinite linear;
}

@keyframes scanMove {
    0% { top: 0; opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
}

.scan-text {
    position: relative;
    z-index: 4;
    color: #fff;
    font-size: 32rpx;
    font-weight: bold;
    letter-spacing: 2rpx;
    background: rgba(0,0,0,0.6);
    padding: 16rpx 48rpx;
    border-radius: 100rpx;
    border: 1rpx solid rgba(255,255,255,0.2);
}

/* ========== AI 结果卡片 (Pro Max) ========== */
.ai-result-sheet {
    background: #FFFFFF;
    border-radius: 40rpx 40rpx 0 0;
    padding: 0 40rpx 40rpx 40rpx;
    display: flex;
    flex-direction: column;
    gap: 32rpx;
}

/* 顶部 Handle */
.handle-bar {
    width: 80rpx;
    height: 8rpx;
    background: #E5E7EB;
    border-radius: 4rpx;
    margin: 20rpx auto 10rpx auto;
}

/* 1. 结果头部 */
.result-header {
    display: flex;
    align-items: center;
    gap: 24rpx;
}

.result-img {
    width: 120rpx;
    height: 120rpx;
    border-radius: 24rpx;
    border: 2rpx solid #F3F4F6;
}

.result-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.meta-label {
    font-size: 20rpx;
    color: #34D399; /* Brand Green */
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1rpx;
    margin-bottom: 4rpx;
}

.meta-title-row {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.meta-title-input {
    font-size: 36rpx;
    font-weight: 800;
    color: #1F2937;
    flex: 1;
    height: 50rpx;
}

.edit-icon {
    font-size: 28rpx;
    color: #9CA3AF;
}

/* 2. 数据卡片 */
.result-data-card {
    background: #F9FAFB;
    border-radius: 32rpx;
    padding: 32rpx;
    display: flex;
    flex-direction: column;
    gap: 24rpx;
    border: 2rpx solid #F3F4F6;
}

.calories-row {
    display: flex;
    align-items: baseline;
    gap: 8rpx;
}

.cal-val {
    font-size: 56rpx;
    font-weight: 900;
    color: #1F2937;
    line-height: 1;
}

.cal-unit {
    font-size: 24rpx;
    font-weight: bold;
    color: #6B7280;
}

.cal-label {
    font-size: 20rpx;
    color: #9CA3AF;
    margin-left: auto;
}

.macros-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #FFFFFF;
    border-radius: 24rpx;
    padding: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
}

.macro-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rpx;
    flex: 1;
}

.macro-val {
    font-size: 28rpx;
    font-weight: 800;
}

.macro-val.protein { color: #8B5CF6; }
.macro-val.carbs { color: #3B82F6; }
.macro-val.fat { color: #F59E0B; }

.macro-tag {
    font-size: 20rpx;
    color: #9CA3AF;
}

.macro-divider {
    width: 2rpx;
    height: 40rpx;
    background: #E5E7EB;
}

/* 3. 餐次选择 */
.meal-decision-area {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.section-label {
    font-size: 24rpx;
    font-weight: bold;
    color: #6B7280;
}

.meal-capsule-row {
    display: flex;
    gap: 16rpx;
}

.meal-capsule {
    flex: 1;
    height: 72rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F3F4F6;
    color: #6B7280;
    font-size: 26rpx;
    font-weight: 600;
    border-radius: 36rpx;
    transition: all 0.2s;
    border: 2rpx solid transparent;
}

.meal-capsule.active {
    background: #ECFDF5;
    color: #059669;
    border-color: #34D399;
    box-shadow: 0 4rpx 12rpx rgba(52, 211, 153, 0.2);
}

/* 4. 底部按钮 */
.result-actions {
    display: flex;
    gap: 24rpx;
    margin-top: 16rpx;
}

.action-btn {
    height: 96rpx;
    border-radius: 48rpx;
    font-size: 30rpx;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
}

.action-btn.discard {
    flex: 1;
    background: #F3F4F6;
    color: #6B7280;
    border: 1px solid transparent; /* Fix border rendering */
}

.action-btn.save {
    flex: 2;
    background: linear-gradient(135deg, #10B981 0%, #059669 100%);
    color: #fff;
    box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3);
    gap: 12rpx;
}

.action-btn.save:active {
    transform: scale(0.98);
}

.btn-arrow {
    font-size: 36rpx;
    margin-bottom: 4rpx;
}


.greeting {
    font-size: 20rpx;
    color: #9CA3AF;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1rpx;
    margin-bottom: 4rpx;
}

.date-text {
    font-size: 32rpx;
    font-weight: 800;
    color: #111827;
}

.calendar-btn {
    width: 80rpx;
    height: 80rpx;
    background: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
    border: 1rpx solid #F3F4F6;
}

.calendar-icon {
    font-size: 40rpx;
}

/* ========== 主卡路里圆环卡片 - 白陶浮雕 V2 (Ceramic Depth Refined) ========== */
.calorie-circle-card {
    background: #F9FAFB;
    border-radius: 50rpx;
    padding: 64rpx;
    /* 更柔和、更深的浮起效果 */
    box-shadow: 
        20rpx 20rpx 60rpx rgba(174, 174, 192, 0.4), 
        -20rpx -20rpx 60rpx #FFFFFF;
    margin-bottom: 64rpx;
    position: relative;
    overflow: visible;
    text-align: center;
    border: 1rpx solid rgba(255, 255, 255, 0.5); /* 极淡边框 */
}

/* 即使移除了卡片的动态浮起，圆环的容器需要特殊的交互层 */
.circle-container {
    position: relative;
    width: 640rpx;
    height: 640rpx;
    margin: -32rpx auto;
    
    /* 强制居中修正 */
    left: 50%;
    transform: translateX(-50%);
}

/* 圆形进度环容器 - 添加心跳动效 */
.progress-ring {
    position: relative;
    width: 100%;
    height: 100%;
    /* 持续的微弱心跳，赋予界面生命力 */
    animation: ceramic-pulse 3s ease-in-out infinite;
}

/* 陶瓷心跳呼吸动画 */
@keyframes ceramic-pulse {
    0% {
        transform: scale(1);
        filter: drop-shadow(0 0 0 rgba(16, 185, 129, 0));
    }
    50% {
        transform: scale(1.015);
        /* 配合缩放，阴影轻微扩散，产生呼吸感 */
        filter: drop-shadow(0 4rpx 12rpx rgba(16, 185, 129, 0.2));
    }
    100% {
        transform: scale(1);
        filter: drop-shadow(0 0 0 rgba(16, 185, 129, 0));
    }
}

/* 1. 轨道 (Track) */
.ring-track {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 36rpx solid #F0F2F5; 
    box-shadow: 
        inset 6rpx 6rpx 12rpx rgba(174, 174, 192, 0.25), 
        inset -6rpx -6rpx 12rpx #FFFFFF;
    z-index: 1;
}

/* 2. 进度扇形 (Progress Pie) */
/* 使用硬边缘渐变代替 Mask，兼容性最好 */
.ring-progress-pie {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    z-index: 2;
    background: conic-gradient(
        from 0deg, 
        #34D399 0deg, 
        #10B981 var(--progress), 
        transparent var(--progress), 
        transparent 360deg
    );
    /* 进度条的高光/阴影需要简化，因为它是扇形 */
    filter: drop-shadow(0 0 4rpx rgba(16, 185, 129, 0.3));
}

/* 3. 中心遮盖 (Hole Overlay) */
/* 一个比轨道内径稍小的圆，盖住扇形的中心，形成圆环 */
.ring-center-hole {
    position: absolute;
    /* Track宽36rpx。为了避免边缘锯齿露白，遮盖稍微小一点点或者刚好 */
    /* inset = track-width. */
    inset: 36rpx; 
    border-radius: 50%;
    background: #F9FAFB; /* 与卡片背景一致 (!important) */
    z-index: 3;
    
    /* 可选：给内部增加一点点阴影增强立体感，或者保持平整 */
    /* 这里稍微加一点 outward shadow 模拟轨道内壁的挤压感 ? */
    /* 或者仅仅是 clean cut */
}

.circle-content {
    position: absolute;
    inset: 0; /* 恢复全尺寸，只是布局内容 */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 16rpx;
    /* 这是一个真正的镂空，不加背景 */
    background: transparent;
    z-index: 10;
}

.flame-icon {
    font-size: 64rpx;
    margin-bottom: 24rpx;
    /* 实物化图标阴影 */
    filter: drop-shadow(2rpx 4rpx 6rpx rgba(249, 115, 22, 0.2));
}

.remaining-value {
    font-size: 136rpx;
    font-weight: 800; /* 加粗回归，强调实体感 */
    color: #374151; /* 深灰而非纯黑，更柔和 */
    line-height: 1;
    letter-spacing: -6rpx;
    font-family: var(--font-number);
    /* 文字雕刻感 (凸起) */
    text-shadow: 2rpx 2rpx 0px #FFFFFF;
}

.remaining-label {
    font-size: 28rpx;
    color: #9CA3AF;
    font-weight: bold;
    margin-top: 8rpx;
}

.target-pill {
    margin-top: 32rpx;
    background: #F0FDF4;
    color: #16A34A;
    padding: 16rpx 32rpx;
    border-radius: 50rpx;
    font-size: 24rpx;
    font-weight: bold;
    box-shadow: 0 2rpx 8rpx rgba(74, 222, 128, 0.1);
    border: 1rpx solid #BBF7D0;
    text-align: center;
}

.target-main {
    margin-bottom: 4rpx;
}

.target-value {
    font-size: 28rpx;
    font-weight: 800;
}

.target-detail {
    font-size: 20rpx;
    opacity: 0.8;
}

/* ========== 区块标题 ========== */
.section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0 8rpx;
    margin-bottom: 32rpx;
}

.section-title {
    font-size: 36rpx;
    font-weight: 800;
    color: #111827;
}

.section-link {
    font-size: 24rpx;
    color: #10B981;
    font-weight: bold;
}

/* ========== 营养卡片网格 ========== */
.nutrition-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24rpx;
    margin-bottom: 64rpx;
}

.macro-card {
    background: #ffffff;
    padding: 32rpx;
    border-radius: 32rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
    border: 1rpx solid #F9FAFB;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 256rpx;
}

.macro-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24rpx;
}

.macro-label {
    font-size: 24rpx;
    font-weight: bold;
    color: #6B7280;
}

.macro-icon {
    width: 24rpx;
    height: 24rpx;
    border-radius: 50%;
    padding: 8rpx;
    font-size: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.purple-icon {
    background: #F3E8FF;
    color: #9333EA;
}

.blue-icon {
    background: #DBEAFE;
    color: #2563EB;
}

.orange-icon {
    background: #FED7AA;
    color: #EA580C;
}

.macro-value {
    font-size: 40rpx;
    font-weight: 800;
    color: #111827;
    line-height: 1;
    margin-bottom: 4rpx;
    font-family: var(--font-number);
}

.macro-unit {
    font-size: 24rpx;
    color: #9CA3AF;
    font-weight: bold;
    margin-left: 4rpx;
}

.macro-target {
    font-size: 20rpx;
    color: #D1D5DB;
    font-weight: bold;
    margin-bottom: 16rpx;
}

.progress-bar {
    height: 12rpx;
    width: 100%;
    background: #F3F4F6;
    border-radius: 50rpx;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
