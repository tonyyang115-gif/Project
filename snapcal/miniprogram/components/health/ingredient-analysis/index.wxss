/* 复用基础 Modal 样式 */
@import '../bmr-calculator/index.wxss'; 

.modal-content.full-screen {
    height: 90vh;
    background: #f8fafc; /* 浅灰背景 */
}

/* Loading */
.loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 120rpx;
}

.scanner-anim {
    width: 200rpx;
    height: 200rpx;
    border: 4rpx solid #e2e8f0;
    border-radius: 40rpx;
    position: relative;
    overflow: hidden;
    margin-bottom: 40rpx;
    background: #fff;
    box-shadow: 0 20rpx 40rpx rgba(0,0,0,0.05);
}

.scan-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4rpx;
    background: #10b981;
    box-shadow: 0 0 20rpx #10b981;
    animation: scan 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

@keyframes scan {
    0% { top: 0; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
}

.loading-text { font-size: 34rpx; font-weight: 700; color: #1e293b; margin-bottom: 16rpx; }
.loading-sub { font-size: 26rpx; color: #94a3b8; }

/* Score Section */
.score-section {
    display: flex;
    align-items: center;
    padding: 40rpx;
    background: linear-gradient(135deg, #ffffff 0%, #f0fdf4 100%);
    border-radius: 32rpx;
    margin-bottom: 32rpx;
    box-shadow: 0 10rpx 30rpx rgba(16, 185, 129, 0.1);
}

.score-circle {
    width: 140rpx;
    height: 140rpx;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-right: 32rpx;
    border: 8rpx solid;
    flex-shrink: 0;
}

.score-circle.low { border-color: #10b981; color: #10b981; }  /* Safe */
.score-circle.medium { border-color: #f59e0b; color: #f59e0b; background: #fffbeb; }
.score-circle.high { border-color: #ef4444; color: #ef4444; background: #fef2f2; }

.score-num { font-size: 64rpx; font-weight: 800; line-height: 1; }
.score-label { font-size: 20rpx; font-weight: 600; opacity: 0.8; margin-top: 4rpx; }

.score-info { flex: 1; }
.product-name { font-size: 36rpx; font-weight: 800; color: #0f172a; display: block; margin-bottom: 12rpx; }
.score-summary { font-size: 26rpx; color: #64748b; line-height: 1.4; display: block; }

/* Risk Overview */
.risk-overview {
    margin-bottom: 32rpx;
}
.section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 20rpx;
    padding: 0 8rpx;
}
.section-title { font-size: 30rpx; font-weight: 800; color: #334155; }
.count-badge { font-size: 24rpx; color: #94a3b8; background: #e2e8f0; padding: 4rpx 12rpx; border-radius: 20rpx; }

.risk-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}
.risk-tag {
    padding: 10rpx 24rpx;
    border-radius: 12rpx;
    background: #fff;
    color: #475569;
    font-size: 24rpx;
    font-weight: 600;
    border: 1rpx solid #e2e8f0;
}
.risk-tag.high { background: #fef2f2; color: #ef4444; border-color: #fca5a5; }

/* Suggestions */
.suggestion-box {
    background: #eff6ff;
    border-radius: 24rpx;
    padding: 24rpx;
    margin-bottom: 40rpx;
    display: flex;
    gap: 20rpx;
}
.ai-avatar { font-size: 40rpx; flex-shrink: 0; }
.suggestion-content { flex: 1; }
.suggestion-item {
    font-size: 26rpx;
    color: #1e40af;
    line-height: 1.5;
    margin-bottom: 8rpx;
}
.suggestion-item:last-child { margin-bottom: 0; }

/* Ingredient List */
.ingredient-section {
    background: #fff;
    border-radius: 32rpx;
    padding: 32rpx;
    margin-bottom: 180rpx; /* Space for button */
    box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
}

.ing-row {
    display: flex;
    align-items: flex-start;
    padding: 24rpx 0;
    border-bottom: 1rpx solid #f1f5f9;
}
.ing-row:last-child { border-bottom: none; }

.ing-type-icon {
    width: 64rpx;
    height: 64rpx;
    border-radius: 16rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
    font-size: 32rpx;
    margin-right: 24rpx;
    flex-shrink: 0;
}
.ing-type-icon.additive { background: #ede9fe; color: #7c3aed; }
.ing-type-icon.sugar { background: #ffedd5; color: #c2410c; }
.ing-type-icon.fat { background: #e0f2fe; color: #0284c7; }
.ing-type-icon.allergen { background: #fee2e2; color: #dc2626; }

.ing-main { flex: 1; }
.ing-name-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.ing-name { font-size: 30rpx; font-weight: 700; color: #0f172a; margin-right: 16rpx; }

.risk-badge {
    font-size: 20rpx;
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
    font-weight: 700;
}
.risk-badge.high { background: #fef2f2; color: #ef4444; }
.risk-badge.medium { background: #fff7ed; color: #ea580c; }

.ing-desc {
    font-size: 24rpx;
    color: #64748b;
    line-height: 1.4;
    display: block;
}

/* Button */
.re-scan-btn {
    position: fixed;
    bottom: 60rpx;
    left: 40rpx;
    right: 40rpx;
    height: 100rpx;
    background: #10b981;
    color: #fff;
    border-radius: 50rpx;
    font-size: 32rpx;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10rpx 40rpx rgba(16, 185, 129, 0.4);
    z-index: 100;
}

.safe-area-bottom {
    height: env(safe-area-inset-bottom);
}
