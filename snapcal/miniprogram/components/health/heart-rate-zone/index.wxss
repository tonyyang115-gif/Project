/* 复用部分基础样式 */
@import '../bmr-calculator/index.wxss'; 

/* 红色主题覆盖 */
/* 红色主题覆盖 -> 转 Mint 背景，但保留红色心跳 */
.result-card.red-theme {
    background: #ecfdf5; /* Mint 50 */
    border-color: #d1fae5;
}

.result-card.red-theme .result-label { color: #047857; /* Dark Green */ }
.result-card.red-theme .result-value { color: #059669; /* Mint 600 */ }
.result-card.red-theme .result-unit { color: #10b981; }
.result-card.red-theme .result-icon { 
    /* Keep Red Heart */
    color: #ef4444;
    box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.1); 
    animation: heartbeat 1.5s infinite;
}

@keyframes heartbeat {
    0% { transform: scale(1); }
    15% { transform: scale(1.15); }
    30% { transform: scale(1); }
    45% { transform: scale(1.15); }
    60% { transform: scale(1); }
    100% { transform: scale(1); }
}

.sub-text {
    font-size: 24rpx;
    color: #059669;
    font-weight: 600;
    margin-top: 16rpx;
}

.red-btn {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%); /* Mint Btn */
    box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.2);
}

/* 分区图表 */
.zone-chart {
    background: #fff;
    padding: 32rpx;
    border-radius: 24rpx;
    margin-bottom: 40rpx;
    border: 1rpx solid #f3f4f6;
}

.zone-item {
    display: flex;
    align-items: center;
    margin-bottom: 24rpx;
    opacity: 0.6;
}

.zone-item.active {
    opacity: 1;
}

.zone-item:last-child {
    margin-bottom: 0;
}

.zone-bar {
    width: 8rpx;
    height: 64rpx;
    border-radius: 4rpx;
    margin-right: 24rpx;
}

.zone-bar.gray { background: #d1d5db; }
.zone-bar.red { background: #ef4444; }
.zone-bar.orange { background: #f97316; }

.zone-info {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.zone-title {
    font-size: 26rpx;
    font-weight: 700;
    color: #374151;
}

.zone-title.red-text { color: #dc2626; }

.zone-val {
    font-size: 22rpx;
    color: #6b7280;
    font-weight: 600;
}
