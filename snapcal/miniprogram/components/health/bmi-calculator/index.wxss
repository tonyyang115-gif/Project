/* 弹窗容器 */
.tool-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    visibility: hidden;
    opacity: 0;
    transition: all 0.3s ease;
}

.tool-modal.show {
    visibility: visible;
    opacity: 1;
}

.modal-mask {
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
}

.modal-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    border-radius: 40rpx 40rpx 0 0;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.19, 1, 0.22, 1);
    max-height: 85vh;
    display: flex;
    flex-direction: column;
}

.tool-modal.show .modal-content {
    transform: translateY(0);
}

.modal-header {
    padding: 32rpx 40rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1rpx solid #f3f4f6;
}

.modal-title {
    font-size: 32rpx;
    font-weight: 800;
    color: #1f2937;
}

.close-btn {
    font-size: 40rpx;
    color: #9ca3af;
    padding: 10rpx;
}

.modal-body {
    padding: 40rpx;
    overflow-y: auto;
}

/* 结果展示区 - 仪表盘 */
.result-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 40rpx;
    background: #ffffff;
    border-radius: 40rpx;
    padding: 40rpx;
    box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.04);
}

.speedometer-container {
    position: relative;
    width: 400rpx;
    height: 220rpx; /* Half circle height + margin */
    display: flex;
    justify-content: center;
    /* overflow: hidden; Removed to prevent clipping of edges */
    margin-bottom: 24rpx;
}

.speedometer-gauge {
    position: relative;
    width: 400rpx;
    height: 200rpx;
    /* overflow: hidden; Removed to allow needle overflow if needed, but masked by container */
}

/* 1. 仪表盘轨道系统 */
/* 背景灰轨 */
.gauge-bg-track {
    position: absolute;
    top: 0;
    left: 0;
    width: 400rpx;
    height: 200rpx;
    border-radius: 200rpx 200rpx 0 0;
    background: #f3f4f6; /* Grey base */
    /* Hollow mask - match the colored track */
    /* Hollow mask - match the colored track */
    -webkit-mask-image: radial-gradient(circle at 50% 100%, transparent 68%, black 69%);
    mask-image: radial-gradient(circle at 50% 100%, transparent 68%, black 69%);
    z-index: 1;
}

/* 彩虹进度轨 */
.gauge-track {
    width: 400rpx;
    height: 200rpx; /* Half height */
    border-radius: 200rpx 200rpx 0 0; /* Semi-circle shape */
    background: conic-gradient(
        from 270deg at 50% 100%, /* Center at bottom */
        #3b82f6 0deg,   /* 偏瘦 start */
        #3b82f6 30deg,  /* 18.5 split */
        #22c55e 30deg,  
        #22c55e 90deg,  /* 24 split */
        #f97316 90deg,
        #f97316 135deg, /* 28 split */
        #ef4444 135deg,
        #ef4444 180deg,
        transparent 180deg
    );
    /* Mask inner to make it a THIN arc - centered at bottom */
    /* Increase transparent area to 68% for thinner, hollow look */
    /* Mask inner to make it a THIN arc - centered at bottom */
    /* Increase transparent area to 68% for thinner, hollow look */
    -webkit-mask-image: radial-gradient(circle at 50% 100%, transparent 68%, black 69%);
    mask-image: radial-gradient(circle at 50% 100%, transparent 68%, black 69%);
    position: relative;
    z-index: 2;
    /* Soft shadow for floating effect */
    filter: drop-shadow(0 4rpx 12rpx rgba(0,0,0,0.1)); 
}

/* 2. 刻度线 (Ticks) */
.gauge-ticks {
    position: absolute;
    inset: 0;
    z-index: 2;
}

.tick {
    position: absolute;
    top: 0;
    left: 50%;
    width: 2rpx;
    height: 20rpx;
    background: rgba(255,255,255,0.8);
    transform-origin: 50% 200rpx; /* Center of the full circle */
}

.t-18-5 { transform: rotate(-60deg); } /* approx for 18.5 */
.t-24   { transform: rotate(0deg); }   /* approx for 24 (center?) No, 24 is mid-high. */
/* Re-mapping logic: 
   Range 15 -> 35 (Span 20)
   180 degrees. 9 deg per BMI unit.
   Start (15) = -90deg.
   18.5 = 15 + 3.5 => 3.5 * 9 = 31.5 deg from start => -58.5 deg
   24 = 15 + 9 => 9 * 9 = 81 deg from start => -9 deg
   28 = 15 + 13 => 13 * 9 = 117 deg from start => +27 deg
*/
.t-18-5 { transform: translateX(-50%) rotate(-58.5deg); }
.t-24   { transform: translateX(-50%) rotate(-9deg); }
.t-28   { transform: translateX(-50%) rotate(27deg); }


/* 3. 指针 (Needle - Pro Max Style) */
.needle-container {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 0;
    z-index: 10;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); /* Bouncy spring */
}

.needle {
    position: absolute;
    bottom: -16rpx; /* Push down to center pivot */
    left: -6rpx;
    width: 12rpx;
    height: 180rpx; /* Length */
    background: #1f2937;
    /* Tapered shape using clip-path or border-radius */
    border-radius: 50% 50% 4rpx 4rpx;
    transform-origin: 50% calc(100% - 16rpx); /* Pivot around the circle center */
    
    /* Simulate Pivot Point via Pseudo-element */
    display: flex;
    justify-content: center;
    align-items: flex-end;
}

/* Pivot Circle */
.needle::after {
    content: '';
    position: absolute;
    bottom: 10rpx; /* Center it */
    width: 24rpx;
    height: 24rpx;
    background: #fff;
    border: 6rpx solid #1f2937;
    border-radius: 50%;
    box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}

/* 4. 中心盖板 (Center Cap) & Value */
.gauge-center {
    position: absolute;
    bottom: -10rpx;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 20;
}

.bmi-value {
    font-size: 64rpx;
    font-weight: 900;
    color: #1f2937;
    line-height: 1;
    font-family: var(--font-number);
}

.bmi-unit {
    font-size: 24rpx;
    font-weight: 700;
    color: #9cb3c9;
    margin-top: 4rpx;
}

/* 状态药丸 */
.status-pill {
    padding: 8rpx 24rpx;
    border-radius: 30rpx;
    font-size: 24rpx;
    font-weight: 800;
    margin-top: 20rpx;
}

.status-pill.green { background: #dcfce7; color: #166534; }
.status-pill.blue { background: #dbeafe; color: #1e40af; }
.status-pill.orange { background: #ffedd5; color: #9a3412; }
.status-pill.red { background: #fee2e2; color: #991b1b; }

/* 建议提示 */
.tips-box {
    display: flex;
    align-items: flex-start;
    background: #f9fafb;
    padding: 24rpx;
    border-radius: 20rpx;
    width: 100%;
    margin-top: 24rpx;
}

.tip-icon {
    font-size: 32rpx;
    margin-right: 16rpx;
    margin-top: 4rpx;
}

.tip-text {
    font-size: 26rpx;
    color: #4b5563;
    line-height: 1.5;
    flex: 1;
    text-align: left;
    font-weight: 500;
}

/* 输入区 */
.input-section {
    background: #f9fafb;
    padding: 32rpx;
    border-radius: 24rpx;
    margin-bottom: 40rpx;
}

.input-group {
    margin-bottom: 40rpx;
}

.input-group:last-child {
    margin-bottom: 0;
}

.label-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 16rpx;
}

.label {
    font-size: 28rpx;
    color: #4b5563;
    font-weight: 600;
}

.value-display {
    font-size: 32rpx;
    color: #1f2937;
    font-weight: 800;
}

.save-btn {
    background: #1f2937;
    color: #fff;
    border-radius: 50rpx;
    font-size: 30rpx;
    font-weight: 600;
    padding: 24rpx 0;
    width: 100%;
}

.save-btn:active {
    opacity: 0.9;
    transform: scale(0.98);
}
