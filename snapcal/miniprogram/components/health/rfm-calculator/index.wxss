/* 复用基础 Modal 样式 */
@import '../bmr-calculator/index.wxss'; 

.result-card.cyan-theme {
    background: #ecfdf5; /* Mint 50 */
    border-color: #d1fae5;
}

.result-card.cyan-theme .result-value { color: #059669; }
.result-card.cyan-theme .result-unit { color: #10b981; }
.result-card.cyan-theme .result-icon { background: #fff; color: #10b981; box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.1); }

/* 卷尺装饰 */
.tape-visual {
    width: 100%;
    height: 40rpx;
    border-bottom: 2rpx solid #10b981;
    margin: 24rpx 0;
    position: relative;
    overflow: hidden;
}

.tape-ticks {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 10rpx;
    background-image: repeating-linear-gradient(90deg, #10b981, #10b981 2rpx, transparent 2rpx, transparent 20rpx);
}

.cyan-btn {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.2);
}
