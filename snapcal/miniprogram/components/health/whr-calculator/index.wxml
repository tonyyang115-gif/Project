<view class="tool-modal {{visible ? 'show' : ''}}">
  <view class="modal-mask" bindtap="onClose"></view>
  <view class="modal-content">
    <view class="modal-header">
      <text class="modal-title">腰臀比 (WHR)</text>
      <view class="close-btn" bindtap="onClose">×</view>
    </view>

    <scroll-view scroll-y class="modal-body">
      
      <!-- 结果卡片: 靛蓝主题 -->
      <view class="result-card indigo-theme">
        <view class="shape-visual">
            <view class="shape-icon {{bodyShape}}"></view>
            <text class="shape-label">{{bodyShape === 'apple' ? '苹果型' : '梨型'}}身材</text>
        </view>
        
        <view class="result-row">
            <text class="result-value">{{result.value}}</text>
            <view class="status-badge {{result.isHealthy ? 'green' : 'red'}}">
                {{result.isHealthy ? '标准' : '中心肥胖风险'}}
            </view>
        </view>

        <!-- 线性刻度尺 -->
        <view class="linear-scale-container">
            <view class="scale-bar split-colors"></view>
            <view class="scale-marker" style="left: 60%"></view> 
            <view class="scale-cursor" style="left: {{percent}}%"></view>
            <view class="scale-labels">
                <text>0.6</text>
                <text class="threshold-label">阈值 {{gender === '男' ? '0.9' : '0.85'}}</text>
                <text>1.2</text>
            </view>
        </view>
        
        <text class="result-tip">中心性肥胖与心血管疾病风险密切相关，请保持腰围控制。</text>
      </view>

      <!-- 输入区 -->
      <view class="input-section">
        <view class="input-group">
            <view class="label-row">
                <text class="label">腰围 (cm)</text>
                <text class="value-display">{{waist}}</text>
            </view>
            <slider min="50" max="150" value="{{waist}}" activeColor="#10B981" bindchanging="onWaistChange" bindchange="onWaistChange" />
        </view>

        <view class="input-group">
            <view class="label-row">
                <text class="label">臀围 (cm)</text>
                <text class="value-display">{{hip}}</text>
            </view>
            <slider min="50" max="150" value="{{hip}}" activeColor="#10B981" bindchanging="onHipChange" bindchange="onHipChange" />
        </view>
      </view>

      <button class="save-btn indigo-btn" bindtap="onSave">同步围度数据</button>
      <view style="height: 40rpx;"></view>
    </scroll-view>
  </view>
</view>
