/* pages/history/index.wxss */
.history-container {
  min-height: 100vh;
  background-color: #f6f7f9;
  width: 100%;
  box-sizing: border-box;
}

.history-list {
  height: 100vh;
  padding: 24rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  color: #999999;
}

.empty-icon {
  font-size: 128rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
}

.history-item {
  background-color: #ffffff;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid #f0f0f0;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.history-date {
  font-size: 24rpx;
  font-weight: bold;
  color: #666666;
}

.history-rounds {
  font-size: 24rpx;
  background-color: #eef2ff;
  color: #4c88ff;
  padding: 8rpx 16rpx;
  border-radius: 40rpx;
  font-weight: 500;
}

.history-players {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
  width: 100%;
}

.history-player {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 80rpx;
  gap: 6rpx;
  flex-shrink: 0;
}

.player-name-small {
  font-size: 20rpx;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
  text-align: center;
}

.player-score-small {
  font-size: 20rpx;
  font-weight: bold;
}

.player-score-small.positive {
  color: #fa9d3b;
}

.player-score-small.negative {
  color: #07c160;
}

