/* pages/home/index.wxss */
.home-container {
  min-height: 100vh;
  background-color: #f6f7f9;
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
}

.content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.user-avatar-section {
  margin-bottom: 24rpx;
  position: relative;
}

.avatar-wrapper {
  position: relative;
}

.avatar-large {
  border: 8rpx solid #ffffff;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.edit-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 50%;
  padding: 12rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  font-size: 24rpx;
  color: #666666;
}

.user-name-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 48rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.edit-icon-small {
  font-size: 32rpx;
  color: #999999;
}

.hint-text {
  color: #999999;
  font-size: 24rpx;
  margin-bottom: 200rpx;
}

.create-room-btn {
  width: 100%;
  max-width: 600rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #4c88ff 0%, #3b76f6 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(76, 136, 255, 0.2);
  border: none;
}

.join-room-btn {
  width: 100%;
  max-width: 600rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #4c88ff 0%, #3b76f6 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 20rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(76, 136, 255, 0.2);
  border: none;
}

.instruction-text {
  color: #666666;
  font-size: 28rpx;
  border-bottom: 2rpx solid #666666;
  padding-bottom: 8rpx;
}

.footer {
  padding: 40rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.footer-logo {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #4c88ff;
  font-weight: bold;
  font-size: 32rpx;
}

.logo-icon {
  background-color: #4c88ff;
  color: #ffffff;
  padding: 4rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.footer-disclaimer {
  font-size: 20rpx;
  color: #999999;
  max-width: 90%;
  line-height: 1.5;
  white-space: pre-line;
  word-wrap: break-word;
}

.footer-version {
  font-size: 20rpx;
  color: #cccccc;
  margin-top: 8rpx;
}

/* 个人中心模态框 */
.profile-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.profile-modal.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
}

.modal-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #f6f7f9;
  overflow-y: auto;
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from {
    transform: translateX(100%);
  }
  to {
    transform: translateX(0);
  }
}

.modal-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: linear-gradient(180deg, #dae4ff 0%, #eef2ff 100%);
}

.modal-close {
  font-size: 48rpx;
  color: #1a1a1a;
  line-height: 1;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.modal-placeholder {
  width: 48rpx;
}

.modal-hero {
  background: linear-gradient(180deg, #eef2ff 0%, #f6f7f9 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 64rpx;
}

.modal-list {
  padding: 32rpx;
  margin-top: -32rpx;
}

/* 子模态框 */
.sub-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2100;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.sub-modal.show {
  opacity: 1;
  pointer-events: auto;
}

.sub-modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
}

.sub-modal-content {
  position: relative;
  z-index: 10;
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx;
  width: 90%;
  max-width: 600rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  animation: zoomIn 0.3s ease;
}

@keyframes zoomIn {
  from {
    transform: scale(0.95);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.sub-modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 32rpx;
  display: block;
}

.sub-modal-input {
  width: 100%;
  background-color: #f5f5f5;
  border: 2rpx solid #e5e5e5;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.sub-modal-input:focus {
  border-color: #4c88ff;
}

.avatar-edit-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar-preview {
  position: relative;
  margin-bottom: 24rpx;
}

.preview-avatar {
  border: 4rpx solid #f0f0f0;
}

.upload-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 24rpx;
}

.preset-avatars {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.preset-avatar-item {
  padding: 4rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.preset-avatar-item.selected {
  border-color: #4c88ff;
}

.sub-modal-buttons {
  display: flex;
  gap: 24rpx;
}

.sub-modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  border: none;
}

.sub-modal-btn.cancel {
  background-color: #f5f5f5;
  color: #666666;
}

.sub-modal-btn.confirm {
  background-color: #4c88ff;
  color: #ffffff;
}

.sub-modal-btn::after {
  border: none;
}

/* 加入房间模态框 */
.join-room-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2100;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.join-room-modal.show {
  opacity: 1;
  pointer-events: auto;
}

.join-room-modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
}

.join-room-modal-content {
  position: relative;
  z-index: 10;
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx;
  width: 90%;
  max-width: 600rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  animation: zoomIn 0.3s ease;
}

.join-room-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 48rpx;
}

.join-room-modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.join-room-modal-close {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.join-room-modal-body {
  margin-bottom: 48rpx;
}

.join-room-hint {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #666666;
  margin-bottom: 24rpx;
}

.join-room-input {
  width: 100%;
  height: 88rpx;
  background-color: #f5f5f5;
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.join-room-input:focus {
  border-color: #4c88ff;
}

.join-room-tip {
  display: block;
  font-size: 24rpx;
  color: #999999;
  text-align: center;
}

.join-room-modal-buttons {
  display: flex;
  gap: 24rpx;
}

.join-room-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  border: none;
}

.join-room-btn.cancel {
  background-color: #f5f5f5;
  color: #666666;
}

.join-room-btn.confirm {
  background-color: #4c88ff;
  color: #ffffff;
}

.join-room-btn::after {
  border: none;
}

